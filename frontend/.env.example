# Frontend build/runtime configuration.
#
#   cp .env.example .env
#
# The API base URL. In development the Vite dev server proxies "/api" to the
# backend (see vite.config.ts), so the default relative path works with no
# CORS setup. In production behind nginx the SPA and API share an origin, so
# "/api/v1" is correct there too.
VITE_API_BASE_URL=/api/v1

# Where the dev-server proxy forwards "/api" requests. Only used by `npm run dev`.
VITE_PROXY_TARGET=http://localhost:8000
