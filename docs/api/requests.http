### BlackBox API — Phase 1 sample requests
###
### Works with the VS Code REST Client and JetBrains HTTP Client.
### Run top to bottom: the login request captures tokens into variables that
### the later requests reuse.

@host = http://localhost:8000
@api = {{host}}/api/v1
@adminEmail = admin@blackbox.example.com
@adminPassword = ChangeMe123!


### ─────────────────────────────────────────────────────────────
### Health
### ─────────────────────────────────────────────────────────────

### Liveness probe
GET {{host}}/health

### Readiness probe (checks PostgreSQL and Redis)
GET {{host}}/health/ready

### OpenAPI schema
GET {{host}}/openapi.json


### ─────────────────────────────────────────────────────────────
### Authentication
### ─────────────────────────────────────────────────────────────

### Register a new account (gets the `viewer` role)
POST {{api}}/auth/register
Content-Type: application/json

{
  "email": "engineer@example.com",
  "password": "Str0ng!Passw0rd",
  "full_name": "Field Engineer"
}

### Log in as the bootstrap administrator
# @name login
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

@accessToken = {{login.response.body.access_token}}
@refreshToken = {{login.response.body.refresh_token}}

### Current user profile
GET {{api}}/auth/me
Authorization: Bearer {{accessToken}}

### Rotate the refresh token (the old one is revoked)
POST {{api}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}

### Change your own password
POST {{api}}/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "current_password": "{{adminPassword}}",
  "new_password": "N3w!Str0ngPass"
}

### Request a password-reset email
### With EMAIL_BACKEND=console the link is printed in the backend logs.
POST {{api}}/auth/forgot-password
Content-Type: application/json

{
  "email": "engineer@example.com"
}

### Complete the password reset (paste the token from the emailed link)
POST {{api}}/auth/reset-password
Content-Type: application/json

{
  "token": "PASTE_TOKEN_FROM_EMAIL_LINK",
  "new_password": "N3w!Str0ngPass"
}

### Log out of the current session
POST {{api}}/auth/logout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}

### Log out everywhere
POST {{api}}/auth/logout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "all_sessions": true
}


### ─────────────────────────────────────────────────────────────
### Users (admin only)
### ─────────────────────────────────────────────────────────────

### List users
GET {{api}}/users?page=1&page_size=20
Authorization: Bearer {{accessToken}}

### Search by name or email, filtered by role
GET {{api}}/users?q=engineer&role=engineer&is_active=true
Authorization: Bearer {{accessToken}}

### List assignable roles
GET {{api}}/users/roles
Authorization: Bearer {{accessToken}}

### Create a user with an explicit role
# @name createUser
POST {{api}}/users
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "email": "engineer2@example.com",
  "password": "Str0ng!Passw0rd",
  "full_name": "Engineer Two",
  "roles": ["engineer"],
  "is_active": true,
  "is_verified": true
}

@userId = {{createUser.response.body.id}}

### Fetch a single user
GET {{api}}/users/{{userId}}
Authorization: Bearer {{accessToken}}

### Promote a user to engineer
PATCH {{api}}/users/{{userId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "roles": ["engineer"]
}

### Deactivate a user (revokes all of their sessions)
PATCH {{api}}/users/{{userId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "is_active": false
}

### Update your own profile
PATCH {{api}}/users/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "full_name": "Platform Administrator"
}

### Delete a user
DELETE {{api}}/users/{{userId}}
Authorization: Bearer {{accessToken}}


### ─────────────────────────────────────────────────────────────
### Audit trail (admin only)
### ─────────────────────────────────────────────────────────────

### Recent security events
GET {{api}}/audit-logs?page=1&page_size=20
Authorization: Bearer {{accessToken}}

### Failed logins only
GET {{api}}/audit-logs?action=user.login_failed
Authorization: Bearer {{accessToken}}


### ─────────────────────────────────────────────────────────────
### Devices (Phase 2)
### ─────────────────────────────────────────────────────────────

### Register a device (engineer)
# @name createDevice
POST {{api}}/devices
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "device_id": "STM32-F4-0001",
  "serial_number": "SN-2026-000123",
  "firmware_version": "1.4.2",
  "hardware_model": "STM32F407VG",
  "location": "Lab A, Rack 3",
  "tags": ["field-trial", "eu-west"]
}

@deviceUuid = {{createDevice.response.body.id}}

### List devices
GET {{api}}/devices?page=1&page_size=20
Authorization: Bearer {{accessToken}}

### Search and filter
GET {{api}}/devices?q=rack&status=active&hardware_model=STM32F407VG
Authorization: Bearer {{accessToken}}

### Filter by tag
GET {{api}}/devices?tag=field-trial
Authorization: Bearer {{accessToken}}

### Get one device
GET {{api}}/devices/{{deviceUuid}}
Authorization: Bearer {{accessToken}}

### Crash counters for a device
GET {{api}}/devices/{{deviceUuid}}/stats
Authorization: Bearer {{accessToken}}

### Update a device (device_id and serial_number are immutable)
PATCH {{api}}/devices/{{deviceUuid}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "firmware_version": "1.5.0",
  "status": "maintenance",
  "tags": ["field-trial", "eu-west", "batch-7"]
}

### Delete a device (admin only - cascades to its crash history)
DELETE {{api}}/devices/{{deviceUuid}}
Authorization: Bearer {{accessToken}}


### ─────────────────────────────────────────────────────────────
### Device API keys
### ─────────────────────────────────────────────────────────────

### Issue a key - the plaintext is returned ONCE
# @name createKey
POST {{api}}/devices/{{deviceUuid}}/api-keys
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "field-trial-fleet"
}

@deviceKey = {{createKey.response.body.api_key}}
@keyId = {{createKey.response.body.id}}

### List keys (metadata only)
GET {{api}}/devices/{{deviceUuid}}/api-keys
Authorization: Bearer {{accessToken}}

### Revoke a key
DELETE {{api}}/devices/{{deviceUuid}}/api-keys/{{keyId}}
Authorization: Bearer {{accessToken}}

### Device check-in (authenticated by the key alone)
POST {{api}}/devices/heartbeat
X-API-Key: {{deviceKey}}
Content-Type: application/json

{
  "firmware_version": "1.5.0"
}


### ─────────────────────────────────────────────────────────────
### Crash reports
### ─────────────────────────────────────────────────────────────

### Submit a crash - the firmware path
# @name submitCrash
POST {{api}}/crashes
X-API-Key: {{deviceKey}}
Content-Type: application/json

{
  "firmware_version": "1.4.2",
  "build_version": "a1b2c3d",
  "timestamp": "2026-07-27T09:14:22Z",
  "fault_type": "HardFault",
  "exception_type": "IMPRECISERR",
  "task_name": "SensorTask",
  "pc": "0x08001A2C",
  "lr": "0x08001A0F",
  "sp": "0x20017FA0",
  "registers": {
    "r0": "0x00000000",
    "r1": "0x20000100",
    "r2": "0xDEADBEEF",
    "r3": "0x00000001",
    "xpsr": "0x61000000",
    "cfsr": "0x00000400",
    "hfsr": "0x40000000"
  },
  "stack": ["0x08001A2C", "0x20017FB0", "0x08001998"]
}

@crashId = {{submitCrash.response.body.id}}

### A camelCase firmware build - normalised identically
POST {{api}}/crashes
X-API-Key: {{deviceKey}}
Content-Type: application/json

{
  "firmwareVersion": "2.0.0",
  "faultType": "busFault",
  "taskName": "CommsTask",
  "programCounter": 134225964,
  "stackDump": "08001A2C 20017FB0"
}

### A malformed report - stored anyway, with warnings
POST {{api}}/crashes
X-API-Key: {{deviceKey}}
Content-Type: application/json

{
  "firmware_version": "1.5.0",
  "fault_type": "???",
  "timestamp": "whenever",
  "pc": "junk"
}

### A stack overflow reported by FreeRTOS
POST {{api}}/crashes
X-API-Key: {{deviceKey}}
Content-Type: application/json

{
  "firmware_version": "1.4.2",
  "fault_type": "stack overflow",
  "task_name": "LoggerTask",
  "sp": "0x20018000"
}

### A watchdog reset - no registers at all, still a real crash
POST {{api}}/crashes
X-API-Key: {{deviceKey}}
Content-Type: application/json

{
  "firmware_version": "1.4.2",
  "reason": "IWDG timeout"
}

### Submit on a device's behalf (engineer JWT - device_id required)
POST {{api}}/crashes
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "device_id": "STM32-F4-0001",
  "firmware_version": "1.4.2",
  "fault_type": "MemManage",
  "task_name": "SensorTask",
  "pc": "0x08003000"
}

### Search crash history
GET {{api}}/crashes?page=1&page_size=20&sort=-occurred_at
Authorization: Bearer {{accessToken}}

### Filter by fault type and severity
GET {{api}}/crashes?fault_type=hard_fault&severity=critical
Authorization: Bearer {{accessToken}}

### Filter by device and firmware version
GET {{api}}/crashes?device=STM32-F4-0001&firmware_version=1.4.2
Authorization: Bearer {{accessToken}}

### Filter by triage status and task
GET {{api}}/crashes?status=new&task_name=SensorTask
Authorization: Bearer {{accessToken}}

### Only crashes still awaiting an AI diagnosis (Phase 3)
GET {{api}}/crashes?diagnosed=false
Authorization: Bearer {{accessToken}}

### Full report including register and stack dumps
GET {{api}}/crashes/{{crashId}}
Authorization: Bearer {{accessToken}}

### Triage - only status, severity and notes may change
PATCH {{api}}/crashes/{{crashId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "investigating",
  "severity": "high",
  "notes": "DMA transfer races the ADC ISR; suspect a missing barrier."
}

### Delete a crash report (admin only)
DELETE {{api}}/crashes/{{crashId}}
Authorization: Bearer {{accessToken}}

###############################################################################
# Phase 3 — AI Diagnosis (RAG)
###############################################################################

### Ingest a knowledge-base document from text (engineer)
POST {{api}}/knowledge-base/documents
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "HardFault troubleshooting - FreeRTOS stack overflow",
  "source_type": "troubleshooting",
  "content": "A HardFault raised inside a FreeRTOS task is most often caused by a task stack overflow. When a task overflows its stack the memory access traps as a HardFault escalated from a bus fault. Check the CFSR and BFAR fault registers, enable configCHECK_FOR_STACK_OVERFLOW, and increase the task stack depth."
}

### Upload a text/markdown document (engineer)
POST {{api}}/knowledge-base/documents/upload
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=----blackbox

------blackbox
Content-Disposition: form-data; name="source_type"

arm_cortex_m
------blackbox
Content-Disposition: form-data; name="file"; filename="cortex-m-faults.md"
Content-Type: text/markdown

The Cortex-M Configurable Fault Status Register (CFSR) records the cause of a
HardFault escalation. A precise bus fault sets BFARVALID and latches the
faulting address into BFAR.
------blackbox--

### Knowledge-base overview: totals and active providers (viewer)
GET {{api}}/knowledge-base/stats
Authorization: Bearer {{accessToken}}

### List / filter the corpus (viewer)
GET {{api}}/knowledge-base/documents?source_type=troubleshooting&status=indexed
Authorization: Bearer {{accessToken}}

### Semantic search over the knowledge base (engineer)
POST {{api}}/knowledge-base/search
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "query": "HardFault in a FreeRTOS task, stack overflow",
  "top_k": 5
}

### Delete a document and its chunks (admin only)
DELETE {{api}}/knowledge-base/documents/{{documentId}}
Authorization: Bearer {{accessToken}}

### Diagnose a crash with RAG (engineer)
POST {{api}}/crashes/{{crashId}}/diagnose
Authorization: Bearer {{accessToken}}

### Diagnosis history for a crash, newest first (viewer)
GET {{api}}/crashes/{{crashId}}/diagnoses
Authorization: Bearer {{accessToken}}

### One diagnosis with its sources and provenance (viewer)
GET {{api}}/diagnoses/{{diagnosisId}}
Authorization: Bearer {{accessToken}}

###############################################################################
# Phase 5 — Analytics, Export & Notifications
###############################################################################

### Dashboard summary (viewer)
GET {{api}}/analytics/summary
Authorization: Bearer {{accessToken}}

### Crash trend over 30 days
GET {{api}}/analytics/crash-trend?days=30
Authorization: Bearer {{accessToken}}

### Fault / severity / status distribution
GET {{api}}/analytics/fault-distribution
Authorization: Bearer {{accessToken}}

### Crashes by firmware version
GET {{api}}/analytics/firmware-comparison?limit=10
Authorization: Bearer {{accessToken}}

### Device reliability and MTBF
GET {{api}}/analytics/device-reliability?limit=10
Authorization: Bearer {{accessToken}}

### AI diagnosis confidence distribution
GET {{api}}/analytics/confidence-distribution
Authorization: Bearer {{accessToken}}

### Export crash history as CSV
GET {{api}}/export/crashes.csv?severity=critical
Authorization: Bearer {{accessToken}}

### Export the analytics report as PDF
GET {{api}}/export/analytics.pdf
Authorization: Bearer {{accessToken}}

### Your notifications
GET {{api}}/notifications
Authorization: Bearer {{accessToken}}

### Unread count (bell badge)
GET {{api}}/notifications/unread-count
Authorization: Bearer {{accessToken}}

### Mark one notification read
POST {{api}}/notifications/{{notificationId}}/read
Authorization: Bearer {{accessToken}}

### Mark all notifications read
POST {{api}}/notifications/read-all
Authorization: Bearer {{accessToken}}

### Get alert settings (admin)
GET {{api}}/notifications/settings
Authorization: Bearer {{accessToken}}

### Update alert settings (admin)
PATCH {{api}}/notifications/settings
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "min_severity": "high",
  "email_enabled": true,
  "recipient_roles": ["admin", "engineer"]
}
