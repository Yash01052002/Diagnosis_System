# ---------------------------------------------------------------------------
# BlackBox environment configuration
#
#   cp .env.example .env
#
# Every value below has a safe development default. The ones marked CHANGE ME
# MUST be replaced before any deployment that is reachable by anyone else.
# ---------------------------------------------------------------------------

# -- Application -------------------------------------------------------------
PROJECT_NAME="BlackBox Crash Diagnosis API"
ENVIRONMENT=local                 # local | test | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1

# -- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                     # false gives colourised console output

# -- Security ----------------------------------------------------------------
# CHANGE ME: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160        # 14 days
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
PASSWORD_MIN_LENGTH=10
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# -- CORS --------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API from a browser.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -- Database ----------------------------------------------------------------
POSTGRES_SERVER=localhost         # docker compose overrides this to "db"
POSTGRES_PORT=5432
POSTGRES_USER=blackbox
POSTGRES_PASSWORD=blackbox        # CHANGE ME outside local development
POSTGRES_DB=blackbox
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
# Optional full DSN override; wins over the POSTGRES_* values above.
# DATABASE_URL=postgresql+asyncpg://blackbox:blackbox@localhost:5432/blackbox

# -- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -- Email -------------------------------------------------------------------
EMAIL_BACKEND=console             # console logs the message; smtp sends it
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=no-reply@blackbox.example.com
EMAILS_FROM_NAME=BlackBox

# -- Firmware artifacts (Phase 2.5) ------------------------------------------
# Uploaded ELF/MAP files. Mount this as a Docker volume: symbols are stored in
# the database, but resolving source line numbers needs the original file.
ARTIFACT_STORAGE_DIR=./data/artifacts
MAX_ARTIFACT_SIZE_MB=256
# Optional external addr2line (e.g. arm-none-eabi-addr2line). Purely an
# enhancement - symbolization works without it via pyelftools, so no cross
# toolchain is required in the container.
# ADDR2LINE_BINARY=

# -- Frontend ----------------------------------------------------------------
# Used to build password-reset links.
FRONTEND_URL=http://localhost:5173

# -- Bootstrap administrator -------------------------------------------------
# Created on first start by scripts/seed.sh / app.db.init_db.
FIRST_SUPERUSER_EMAIL=admin@blackbox.example.com
FIRST_SUPERUSER_PASSWORD=ChangeMe123!     # CHANGE ME

# -- Host port mapping (docker compose) --------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000                # nginx serves the SPA and proxies /api to the backend
POSTGRES_EXPOSED_PORT=5432
REDIS_EXPOSED_PORT=6379

# -- AI diagnosis engine (Phase 3) -------------------------------------------
# The defaults below are fully offline and deterministic: a template LLM,
# hashing embeddings and a database-backed vector store. They need no API key
# and no extra services, so the RAG pipeline works out of the box. Swapping in
# a real model is configuration only - no code change.

# Which language model generates diagnoses.
#   template : deterministic, offline, grounds answers in retrieved context
#   openai   : OpenAI (or any OpenAI-compatible endpoint via OPENAI_BASE_URL)
#   ollama   : a local model served by Ollama
LLM_PROVIDER=template
# Which model produces embeddings. Must match how documents were indexed;
# changing it means existing documents have to be re-indexed.
#   hashing | openai | ollama
EMBEDDING_PROVIDER=hashing
# Where chunk vectors live.  database : inline on chunk rows (no extra service)
#                            chroma   : a ChromaDB instance (pip install .[chroma])
VECTOR_STORE=database

# -- OpenAI (only when LLM_PROVIDER/EMBEDDING_PROVIDER=openai) ----------------
# OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -- Ollama (only when LLM_PROVIDER/EMBEDDING_PROVIDER=ollama) ----------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -- ChromaDB (only when VECTOR_STORE=chroma) --------------------------------
# Connects to a Chroma server over HTTP (see the optional "chroma" service in
# docker-compose.yml). Install the client with: pip install .[chroma]
CHROMA_HOST=localhost              # docker compose overrides this to "chroma"
CHROMA_PORT=8001
CHROMA_COLLECTION=blackbox_kb

# -- RAG tuning --------------------------------------------------------------
HASHING_EMBEDDING_DIM=384          # dimension of the offline hashing embeddings
CHUNK_SIZE=1000                    # characters per chunk
CHUNK_OVERLAP=150                  # overlap between adjacent chunks
MAX_DOCUMENT_SIZE_MB=32
RAG_TOP_K=6                        # passages retrieved per query
RAG_MIN_RELEVANCE=0.18             # drop hits below this cosine score
RAG_CONFIDENCE_FLOOR=0.18          # below this best-match score, a diagnosis is "uncertain"
RAG_CERTAIN_THRESHOLD=0.55         # at/above this retrieval score, a diagnosis is "certain"
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60
