# ---------------------------------------------------------------------------
# BlackBox environment configuration
#
#   cp .env.example .env
#
# Every value below has a safe development default. The ones marked CHANGE ME
# MUST be replaced before any deployment that is reachable by anyone else.
# ---------------------------------------------------------------------------

# -- Application -------------------------------------------------------------
PROJECT_NAME="BlackBox Crash Diagnosis API"
ENVIRONMENT=local                 # local | test | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1

# -- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                     # false gives colourised console output

# -- Security ----------------------------------------------------------------
# CHANGE ME: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160        # 14 days
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
PASSWORD_MIN_LENGTH=10
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# -- CORS --------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API from a browser.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -- Database ----------------------------------------------------------------
POSTGRES_SERVER=localhost         # docker compose overrides this to "db"
POSTGRES_PORT=5432
POSTGRES_USER=blackbox
POSTGRES_PASSWORD=blackbox        # CHANGE ME outside local development
POSTGRES_DB=blackbox
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
# Optional full DSN override; wins over the POSTGRES_* values above.
# DATABASE_URL=postgresql+asyncpg://blackbox:blackbox@localhost:5432/blackbox

# -- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -- Email -------------------------------------------------------------------
EMAIL_BACKEND=console             # console logs the message; smtp sends it
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=no-reply@blackbox.example.com
EMAILS_FROM_NAME=BlackBox

# -- Frontend ----------------------------------------------------------------
# Used to build password-reset links.
FRONTEND_URL=http://localhost:5173

# -- Bootstrap administrator -------------------------------------------------
# Created on first start by scripts/seed.sh / app.db.init_db.
FIRST_SUPERUSER_EMAIL=admin@blackbox.example.com
FIRST_SUPERUSER_PASSWORD=ChangeMe123!     # CHANGE ME

# -- Host port mapping (docker compose) --------------------------------------
BACKEND_PORT=8000
POSTGRES_EXPOSED_PORT=5432
REDIS_EXPOSED_PORT=6379

# -- AI layer (Phase 3; unused for now) --------------------------------------
# OPENAI_API_KEY=
# LLM_PROVIDER=openai             # openai | ollama | local
# EMBEDDING_MODEL=text-embedding-3-small
# VECTOR_STORE=chroma             # chroma | qdrant
# CHROMA_PERSIST_DIR=./data/chroma
